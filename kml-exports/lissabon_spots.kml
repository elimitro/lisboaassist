<Document>
  <name>Lissabon Spots (2026-08-02)</name>
  <Folder>
    <name>Kultur &amp; Events</name>
    <Placemark>
      <name>Fundacao Calouste Gulbenkian</name>
      <description><![CDATA[Exzellenter Konzertsaal fuer klassische Konzerte mit Residenzorchester. Die Gaerten eignen sich hervorragend zum Arbeiten/Lernen.<br/><i>Tipp: Cartao Gulbenkian (kostenlose Kundenkarte) vorab online beantragen -- schaltet den Buchungs-Button fuer kostenlose Events 24 Std. frueher frei.</i>]]></description>
      <Point>
        <coordinates>-9.1546,38.7369,0</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>Web Summit</name>
      <description><![CDATA[Globales Tech-Event, 09.-12.11.2026. Teilnahme als Volunteer bereits bestaetigt.]]></description>
      <Point>
        <coordinates>-9.0968,38.7639,0</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>Konzert: Tchaikovsky's Serenade for Strings</name>
      <description><![CDATA[24.09.2026, 20:00 Uhr, Fund. Gulbenkian. Kostenlos, aber Online-Reservierung noetig.]]></description>
      <Point>
        <coordinates>-9.1546,38.7369,0</coordinates>
      </Point>
    </Placemark>
  </Folder>
